{
  "name": "mcp-template",
  "version": "0.1.0",
  "description": "MCP server template that works with Hermes Agent from the first run (stdio + Streamable HTTP)",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "mcp-template": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "skills"
  ],
  "scripts": {
    "init": "node scripts/init.mjs",
    "build": "tsc -p tsconfig.json && node ./scripts/copy-webui.mjs",
    "dev": "npm run build && node --watch dist/index.js",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node scripts/smoke-stdio.mjs && node scripts/smoke-http.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3"
  }
}
